# Banco local (docker compose up -d). Em producao use a URL com pool do provedor
# (Neon, Supabase etc.) em DATABASE_URL e a URL direta em DIRECT_URL.
DATABASE_URL="postgresql://anna_meyre:anna_meyre_dev@localhost:5432/anna_meyre_cakes?schema=public"
DIRECT_URL="postgresql://anna_meyre:anna_meyre_dev@localhost:5432/anna_meyre_cakes?schema=public"

JWT_SECRET="change-this-secret-before-production"
JWT_EXPIRES_IN="1d"

# Numero usado se a tabela settings ainda estiver vazia.
DEFAULT_WHATSAPP_NUMBER="5599999999999"

# Opcional: origens extras liberadas no CORS, separadas por virgula.
# Nao e necessario quando frontend e API rodam na mesma origem (Vercel / proxy do Vite).
CORS_ORIGINS=""

PORT=3000

# Usados apenas pelo seed (npm run prisma:seed).
SEED_ADMIN_EMAIL="admin@annameyrecakes.local"
SEED_ADMIN_PASSWORD="change-this-password-before-seeding"
SEED_WHATSAPP_NUMBER="5599999999999"
